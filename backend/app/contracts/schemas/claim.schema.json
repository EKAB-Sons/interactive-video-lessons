{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ivl.ekab-sons.dev/schemas/claim.schema.json",
  "title": "Mathematical claim",
  "description": "A fact-bearing assertion a planner makes. Claims are the only route by which a number or formula may reach narration or a fact-bearing scene operation. The verifier recomputes every claim with the exact solver (Retrieval and Mathematical Tools, M6). Tokens for what is true; pixels for what it looks like.",
  "type": "object",
  "required": ["id", "type"],
  "properties": {
    "id": { "type": "string", "pattern": "^c[0-9]{1,3}$", "description": "Short stable ID, e.g. c1. Referenced from narration as {{claim:c1}} and from operations as claim_ref." },
    "type": { "type": "string", "enum": ["derivative", "value_at", "slope_tangent", "slope_secant", "limit", "equivalent", "secant_converges"] },
    "expression": { "type": "string", "maxLength": 200 },
    "var": { "type": "string", "pattern": "^[a-zA-Z]$", "default": "x" },
    "claimed": { "type": ["string", "number"], "description": "What the planner asserts the result is. Must agree with the solver." },
    "at": { "type": "number" },
    "at_x": { "type": "number" },
    "h": { "type": "number" },
    "h_values": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 12 },
    "to": { "type": ["number", "string"], "description": "Limit target; a number, 'oo' or '-oo'." },
    "lhs": { "type": "string", "maxLength": 200 },
    "rhs": { "type": "string", "maxLength": 200 },
    "tolerance": { "type": "number", "exclusiveMinimum": 0, "default": 1e-9 }
  },
  "allOf": [
    { "if": { "properties": { "type": { "const": "derivative" } } }, "then": { "required": ["expression", "claimed"] } },
    { "if": { "properties": { "type": { "const": "value_at" } } }, "then": { "required": ["expression", "at", "claimed"] } },
    { "if": { "properties": { "type": { "const": "slope_tangent" } } }, "then": { "required": ["expression", "at_x", "claimed"] } },
    { "if": { "properties": { "type": { "const": "slope_secant" } } }, "then": { "required": ["expression", "at_x", "h", "claimed"] } },
    { "if": { "properties": { "type": { "const": "limit" } } }, "then": { "required": ["expression", "to", "claimed"] } },
    { "if": { "properties": { "type": { "const": "equivalent" } } }, "then": { "required": ["lhs", "rhs"] } },
    { "if": { "properties": { "type": { "const": "secant_converges" } } }, "then": { "required": ["expression", "at_x", "h_values"] } }
  ]
}
