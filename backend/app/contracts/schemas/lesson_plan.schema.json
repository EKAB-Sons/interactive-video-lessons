{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ivl.ekab-sons.dev/schemas/lesson_plan.schema.json",
  "title": "Base lesson plan (out of the learned boundary)",
  "description": "The Base Lesson Planning Engine's proposal for a whole lesson: an ordered graph of nodes, each carrying narration, claims and scene operations. Verified node by node against a simulated scene before the compiler sees any of it.",
  "type": "object",
  "required": ["kind", "request_id", "planner_id", "config_version", "lesson_id", "topic", "objective", "source_refs", "nodes"],
  "properties": {
    "kind": { "const": "lesson_plan" },
    "request_id": { "type": "string", "minLength": 1 },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 2, "default": 1 },
    "planner_id": { "type": "string", "minLength": 1 },
    "config_version": { "type": "string", "minLength": 1 },
    "model_version": { "type": "string" },
    "lesson_id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "topic": { "type": "string", "minLength": 1, "description": "Must be one of the bounded topics in contracts/topics.json." },
    "objective": { "type": "string", "minLength": 1, "maxLength": 300 },
    "source_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "maxItems": 16 },
    "initial_objects": {
      "type": "object",
      "description": "Objects present before the first node. Same shape as scene_graph.objects.",
      "additionalProperties": { "type": "object", "required": ["kind"], "additionalProperties": true }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": ["node_id", "title", "claims", "operations"],
        "properties": {
          "node_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "concept": { "type": "string", "maxLength": 120 },
          "claims": { "type": "array", "items": { "$ref": "claim.schema.json" }, "maxItems": 24 },
          "operations": { "type": "array", "items": { "type": "object", "required": ["type"], "properties": { "type": { "type": "string", "minLength": 1 } }, "additionalProperties": true }, "minItems": 1, "maxItems": 40 },
          "practice": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": ["prompt", "claim_ref"],
              "properties": {
                "prompt": { "type": "string", "minLength": 1, "maxLength": 300 },
                "claim_ref": { "type": "string", "pattern": "^c[0-9]{1,3}$", "description": "The verified claim whose value is the expected answer. Practice answers are never free text from the planner." }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
